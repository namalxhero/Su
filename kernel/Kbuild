# Kbuild - out-of-tree build file.
#
# This module is NOT built standalone with a Makefile here; it is meant to
# be placed under a kernel source tree's `drivers/` (or similar) directory,
# referenced from that tree's top-level Kbuild/Makefile, and built as part
# of a normal Android kernel build (bazel/build.sh or the legacy
# build/build.sh flow). See ../README.md "Integration" section and
# ../Kconfig for the CONFIG_SU_CORE tristate (module vs. built-in).
#
# DEEP-KERNEL REWORK: the do_execveat_common() argument-layout detection
# that used to live here (SU_EXECVE_HAS_FD_ARG, via
# scripts/detect-execve-fd-arg.sh) is GONE. su_hook.c no longer hooks
# do_execveat_common() at all - it subscribes to the kernel's own
# sched_process_exec tracepoint instead, whose signature is stable
# across every kernel version this project targets, so there is nothing
# left for this file to detect. See su_hook.c's own header comment for
# the full rationale. scripts/detect-execve-fd-arg.sh is now dead and
# has been removed along with the ifeq block that called it.

obj-$(CONFIG_SU_CORE) += su_core.o

su_core-objs := \
	su_main.o \
	su_hook.o \
	su_allowlist.o \
	su_ioctl.o \
	su_boot_trigger.o \
	su_hide.o \
	su_mount_isolate.o

ccflags-y += -I$(src)/include -Wall
