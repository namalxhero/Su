<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so SuDaemonService can keep running + show the Allow/Deny prompt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Su Manager"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.SuManager">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown over other apps when an unknown UID requests su.
             TODO(Phase 3 continued): needs SYSTEM_ALERT_WINDOW handling or
             a high-priority notification + full-screen intent, depending
             on what's reliable across OEM skins - revisit once we can
             test on a real device. -->
        <activity
            android:name=".ui.GrantPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SuManager.Dialog" />

        <service
            android:name=".daemon.SuDaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <receiver
            android:name=".daemon.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
