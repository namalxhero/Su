<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed so SuDaemonService can keep running + show the Allow/Deny prompt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required (as of API 34) for NotificationCompat.Builder's
         setFullScreenIntent() to actually be allowed to launch
         GrantPromptActivity fullscreen from the background - see
         SuDaemonService.showGrantNotification(). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.SuManager">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shown over other apps when an unknown UID requests su.
             Launched via SuDaemonService's full-screen-intent notification
             (showGrantNotification()) rather than a direct startActivity()
             call from the background - that direct call is what this
             activity's old TODO here used to flag as unvalidated; replaced
             with the documented/supported fullscreen-intent mechanism.
             showWhenLocked + turnScreenOn so a request that arrives while
             the device is locked still surfaces instead of silently
             queuing behind the lock screen. -->
        <activity
            android:name=".ui.GrantPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SuManager.Dialog" />

        <service
            android:name=".daemon.SuDaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <receiver
            android:name=".daemon.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
