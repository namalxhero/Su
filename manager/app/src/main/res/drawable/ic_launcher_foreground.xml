<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand redesign - replaces the earlier generic shield placeholder.
    Concept: a terminal prompt (">_") in the project's su_green
    (#00E676) - reads as "root shell access" and is distinct from
    Magisk's stylised M and KernelSU's K at a glance, legible down to
    launcher-icon size. Drawn inside the ~66dp adaptive-icon safe zone
    (viewport is the full 108dp canvas; system masks to a smaller
    visible circle/squircle, so content stays clear of the outer ~21dp
    margin on each side).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- chevron ">" -->
    <path
        android:strokeColor="#00E676"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,38 L58,54 L38,70" />
    <!-- cursor "_" -->
    <path
        android:strokeColor="#00E676"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M64,70 L78,70" />
</vector>
